APP_NAME=orgOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Public URLs -- all three are Cloudflare quick-tunnel values that change
# on every restart; dev.ps1 rewrites them on every dev.cmd run.
# APP_URL: this backend's public URL -- auth emails link to
#   {APP_URL}/open/{screen}?token=..&email=.. (routes/web.php), a small
#   page that redirects into the app.
# FRONTEND_URL: the Expo dev server's public URL.
# APP_DEEP_LINK_BASE: where /open/ redirects to. Expo Go:
#   exp://<frontend tunnel host>/-- ; own build: orgos:// (app.json scheme).
FRONTEND_URL=http://localhost:443
APP_DEEP_LINK_BASE=orgos://

# Social login (app/Services/SocialAuth, see backend/CLAUDE.md).
# Apple needs no secret: the identity token's `aud` must be one of these
# bundle ids (comma list). Default host.exp.Exponent = Expo Go.
# SECURITY: host.exp.Exponent is shared by EVERY app running in Expo Go
# (any of them can obtain tokens with this audience). As soon as the own
# build exists, set this to ONLY its bundle id and drop host.exp.Exponent. Mail to @privaterelay.appleid.com addresses
# ("Hide my email") is only delivered once the sending domain is
# registered in Apple Developer > Sign in with Apple for Email
# Communication.
# APPLE_CLIENT_IDS=host.exp.Exponent
# Google / Facebook (web OAuth via laravel/socialite). Facebook emails
# are treated as unverified (they can create an account, never link to an
# existing one). Leave EMPTY to hide
# the buttons (GET /api/auth/providers). Redirect URI to register with
# the provider: {APP_URL}/auth/google/callback and
# {APP_URL}/auth/facebook/callback -- only stable once APP_URL is a fixed
# domain (quick-tunnel URLs change every run).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lifeos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. MAIL_MAILER=log writes every email to storage/logs/laravel.log
# instead of sending it. To send for real via Brevo (free, 300/day):
# create an SMTP key in Brevo (SMTP & API -> SMTP), verify the sender
# address there, then set (credentials only here, never committed):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<Brevo SMTP login, e.g. 1234abc@smtp-brevo.com>
#   MAIL_PASSWORD=<Brevo SMTP key>
#   MAIL_FROM_ADDRESS=<sender verified in Brevo>
# (MAIL_SCHEME stays null -- port 587 upgrades to TLS via STARTTLS.)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=orgOS

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dev only: an ngrok static domain (e.g. name.ngrok-free.dev). When set,
# dev.ps1 serves the backend on it instead of a changing Cloudflare tunnel
# (stable APP_URL for OAuth redirect URIs and email links). Requires
# `ngrok config add-authtoken <token>` once.
# DEV_NGROK_DOMAIN=
